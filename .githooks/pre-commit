#!/bin/bash
# Build the pages from the data before every commit, so a change to hooks.json, sill.json, boxes.json, porch.json or a room
# can't be committed without the page that shows it. Then check what is staged for secrets.
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 build.py >/dev/null || { echo "pre-commit: build.py failed; nothing committed" >&2; exit 1; }
git add index.html window.html yard.html basement.html porch.html hung/*.html 2>/dev/null
exec .githooks/check-secrets --staged
